if CONFIG["COMPILE_ENVIRONMENT"]:
    CbindgenHeader("brxon.h", inputs=["/netwerk/brxon"])
    EXPORTS.mozilla.net += [
        "!brxon.h",
    ]

# ⚠️ لا يوجد RustLibrary("brxon") هنا عمدًا.
# Firefox يسمح بمكتبة Rust واحدة بس مرتبطة بكل binary (libxul.so في
# حالتنا). brxon يندمج كـ dependency عادي داخل gkrust-shared
# (toolkit/library/rust/shared) بدل ما يكون RustLibrary مستقلة —
# غير هيك، رموزه (brxon_init، brxon_should_load...) ما توصل أبدًا
# لعملية الربط النهائي حتى لو تصرّف بنجاح لحاله.
# مرجع: https://firefox-source-docs.mozilla.org/build/buildsystem/rust.html
